# Enoma Digital Technologies – Apache configuration for shared hosting
# Requires mod_rewrite (standard on cPanel / most shared hosts).

Options -Indexes -MultiViews
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Force HTTPS and the bare domain (uncomment once SSL is active) ──
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} ^www\. [NC]
  # RewriteRule ^ https://enomadigitaltech.com%{REQUEST_URI} [L,R=301]

  # Block private folders and files.
  RewriteRule ^(includes|storage)(/|$) - [F,L]
  RewriteRule ^(config\.sample\.php|router\.php|README\.md|\.git.*)$ - [F,L]

  # Sitemap.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Redirect /page.php and /index to clean URLs (external requests only).
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^ /%1 [R=301,L,NE]
  RewriteRule ^index$ / [R=301,L]

  # Remove trailing slashes on non-directories.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Serve clean URLs from .php files, e.g. /web-development -> web-development.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^([A-Za-z0-9/_-]+)$ $1.php [L]
</IfModule>

# ── Security headers (also sent by PHP) ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Enable after HTTPS is confirmed working:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# ── Caching: assets are versioned (?v=), so they can be cached for a year ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
