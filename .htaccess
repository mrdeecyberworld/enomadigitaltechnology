# Enoma Digital Technologies – Apache configuration for shared hosting
# Requires mod_rewrite (standard on cPanel / most shared hosts).

Options -Indexes -MultiViews
DirectoryIndex index.php
ErrorDocument 404 /index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Force HTTPS and the bare domain (uncomment once SSL is active) ──
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} ^www\. [NC]
  # RewriteRule ^ https://enomadigitaltech.com%{REQUEST_URI} [L,R=301]

  # Block private folders and files.
  RewriteRule ^(includes|storage|pages|deploy)(/|$) - [F,L]
  RewriteRule ^admin/includes(/|$) - [F,L]
  RewriteRule ^(config\.sample\.php|router\.php|README\.md|LOCAL-SETUP\.md|DEPLOY-CPANEL\.md|Dockerfile|docker-compose\.yml|start[.-][^/]*|\.dockerignore|\.user\.ini|\.cpanel\.yml|\.git.*)$ - [F,L]

  # Admin and API scripts without ".php": /admin/login, /api/ai-assistant
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^((?:admin|api)/[A-Za-z0-9_/-]+)$ $1.php [L]

  # Every page address goes to the front controller (index.php), which reads
  # the address table from Admin → Page URLs and handles redirects.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# ── Security headers (also sent by PHP) ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Enable after HTTPS is confirmed working:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# ── Caching: assets are versioned (?v=), so they can be cached for a year ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
